generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String         @id @default(cuid())
  firstName           String
  lastName            String
  email               String         @unique
  phone               String?
  passwordHash        String
  role                String         @default("USER")
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  activities          ActivityLog[]  @relation("ActivityUser")
  aiEstimations       AiEstimation[] @relation("AiReviewedBy")
  appointmentsHandled Appointment[]  @relation("AppointmentHandledBy")
  offersCreated       Offer[]        @relation("OfferCreatedBy")
  prospectsAssigned   Prospect[]     @relation("ProspectAssignedTo")

  @@index([role])
  @@index([active])
}

model Prospect {
  id             String         @id @default(cuid())
  firstName      String
  lastName       String
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  city           String?
  location       String?
  buildingType   String?
  prospectStatus String         @default("NEW")
  source         String?
  notes          String?
  assignedToId   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  aiEstimations  AiEstimation[]
  appointments   Appointment[]
  client         Client?
  documents      Document[]
  notifications  Notification[]
  orders         Order[]
  assignedTo     User?          @relation("ProspectAssignedTo", fields: [assignedToId], references: [id])
  quotes         Quote[]

  @@index([phone])
  @@index([email])
  @@index([prospectStatus])
  @@index([assignedToId])
}

model Client {
  id            String         @id @default(cuid())
  prospectId    String?        @unique
  firstName     String
  lastName      String
  phone         String?
  whatsapp      String?
  email         String?
  address       String?
  city          String?
  location      String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]
  prospect      Prospect?      @relation(fields: [prospectId], references: [id])
  documents     Document[]
  notifications Notification[]
  orders        Order[]
  quotes        Quote[]

  @@index([phone])
  @@index([email])
}

model Document {
  id           String    @id @default(cuid())
  prospectId   String?
  clientId     String?
  quoteId      String?
  name         String
  originalName String
  mimeType     String
  fileUrl      String
  fileSize     Int?
  documentType String    @default("OTHER")
  createdAt    DateTime  @default(now())
  quote        Quote?    @relation(fields: [quoteId], references: [id])
  client       Client?   @relation(fields: [clientId], references: [id])
  prospect     Prospect? @relation(fields: [prospectId], references: [id])

  @@index([prospectId])
  @@index([clientId])
  @@index([quoteId])
}

model Quote {
  id                    String         @id @default(cuid())
  reference             String         @unique
  prospectId            String?
  clientId              String?
  method                String         @default("EQUIPMENT")
  buildingType          String?
  dailyConsumptionKwh   Float?
  monthlyConsumptionKwh Float?
  subscribedPowerKw     Float?
  monthlyBillAmount     Int?
  estimatedDailyKwh     Float?
  estimatedMonthlyKwh   Float?
  estimatedSolarKwc     Float?
  estimatedBatteryKwh   Float?
  estimatedInverterKva  Float?
  status                String         @default("DRAFT")
  technicalNotes        String?
  customerNotes         String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  aiEstimations         AiEstimation[]
  documents             Document[]
  client                Client?        @relation(fields: [clientId], references: [id])
  prospect              Prospect?      @relation(fields: [prospectId], references: [id])
  quoteItems            QuoteItem[]

  @@index([prospectId])
  @@index([clientId])
  @@index([status])
}

model QuoteItem {
  id                  String   @id @default(cuid())
  quoteId             String
  applianceType       String
  applianceName       String?
  quantity            Int      @default(1)
  characteristicName  String?
  characteristicValue Float?
  characteristicUnit  String?
  electricalPowerW    Float?
  operatingHoursDay   Float?
  estimatedDailyKwh   Float?
  notes               String?
  createdAt           DateTime @default(now())
  quote               Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Appointment {
  id          String    @id @default(cuid())
  prospectId  String?
  clientId    String?
  date        DateTime
  time        String
  reason      String
  status      String    @default("PENDING")
  handledById String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  handledBy   User?     @relation("AppointmentHandledBy", fields: [handledById], references: [id])
  client      Client?   @relation(fields: [clientId], references: [id])
  prospect    Prospect? @relation(fields: [prospectId], references: [id])

  @@index([date])
  @@index([status])
  @@index([prospectId])
  @@index([clientId])
}

model Offer {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  category      String       @default("COMMERCIAL")
  description   String?
  price         Int?
  oldPrice      Int?
  promotion     String?
  gift          String?
  stock         Int?
  startDate     DateTime?
  endDate       DateTime?
  active        Boolean      @default(true)
  showPrice     Boolean      @default(true)
  showOldPrice  Boolean      @default(true)
  showGift      Boolean      @default(true)
  showStock     Boolean      @default(true)
  showCountdown Boolean      @default(false)
  showPromotion Boolean      @default(true)
  displayOrder  Int          @default(0)
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     User?        @relation("OfferCreatedBy", fields: [createdById], references: [id])
  images        OfferImage[]
  items         OfferItem[]
  orders        Order[]

  @@index([category])
  @@index([active])
  @@index([displayOrder])
}

model OfferImage {
  id           String   @id @default(cuid())
  offerId      String
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  offer        Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

model OfferItem {
  id          String   @id @default(cuid())
  offerId     String
  name        String
  quantity    Int      @default(1)
  description String?
  createdAt   DateTime @default(now())
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

model Order {
  id            String    @id @default(cuid())
  reference     String    @unique
  prospectId    String?
  clientId      String?
  offerId       String?
  quantity      Int       @default(1)
  unitPrice     Int?
  totalAmount   Int?
  status        String    @default("PENDING")
  customerNotes String?
  internalNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  offer         Offer?    @relation(fields: [offerId], references: [id])
  client        Client?   @relation(fields: [clientId], references: [id])
  prospect      Prospect? @relation(fields: [prospectId], references: [id])

  @@index([prospectId])
  @@index([clientId])
  @@index([offerId])
  @@index([status])
}

model Testimonial {
  id               String   @id @default(cuid())
  customerName     String
  customerLocation String?
  content          String
  rating           Int?
  imageUrl         String?
  active           Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active])
}

model Notification {
  id           String    @id @default(cuid())
  prospectId   String?
  clientId     String?
  type         String
  channel      String
  recipient    String
  subject      String?
  message      String
  status       String    @default("PENDING")
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  client       Client?   @relation(fields: [clientId], references: [id])
  prospect     Prospect? @relation(fields: [prospectId], references: [id])

  @@index([prospectId])
  @@index([clientId])
  @@index([channel])
  @@index([status])
}

model NotificationSetting {
  id            String   @id @default(cuid())
  channel       String   @unique
  enabled       Boolean  @default(false)
  recipient     String?
  provider      String?
  apiKey        String?
  apiSecret     String?
  sender        String?
  configuration String?
  updatedAt     DateTime @updatedAt
}

model AiEstimation {
  id                   String    @id @default(cuid())
  prospectId           String?
  quoteId              String?
  reviewedById         String?
  inputData            String
  resultData           String
  estimatedDailyKwh    Float?
  estimatedSolarKwc    Float?
  estimatedBatteryKwh  Float?
  estimatedInverterKva Float?
  status               String    @default("GENERATED")
  technicalValidation  Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  reviewedBy           User?     @relation("AiReviewedBy", fields: [reviewedById], references: [id])
  quote                Quote?    @relation(fields: [quoteId], references: [id])
  prospect             Prospect? @relation(fields: [prospectId], references: [id])

  @@index([prospectId])
  @@index([quoteId])
  @@index([status])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String?
  entityId    String?
  description String?
  metadata    String?
  createdAt   DateTime @default(now())
  user        User?    @relation("ActivityUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String?
  description String?
  updatedAt   DateTime @updatedAt
}
